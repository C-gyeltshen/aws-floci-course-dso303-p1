{
  "containerDefinitions": [
    {
      "name": "enrolment-api",
      "image": "000000000000.dkr.ecr.us-east-1.localhost:4566/usms-enrolment:r6",
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "USMS_SERVICE",
          "value": "enrolment"
        },
        {
          "name": "USMS_BUCKET",
          "value": "usms-student-data"
        },
        {
          "name": "AWS_REGION",
          "value": "$AWS_REGION_COURSE"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "$LOG_GROUP",
          "awslogs-region": "$AWS_REGION_COURSE",
          "awslogs-stream-prefix": "enrolment"
        }
      }
    }
  ],
  "family": "usms-enrolment",
  "taskRoleArn": "$TASK_ROLE_ARN",
  "executionRoleArn": "$EXEC_ROLE_ARN",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}